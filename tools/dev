#!/usr/bin/env bash
#
# Start the Dev Tools server and reserve Runtime/browser QA tmux windows.
# - The Runtime Supervisor allocates ports and owns service/Web processes.
# - Worktrees also keep their config and dev-tools ports isolated.
# - Dev Tools attaches to or starts the Runtime on the first app/browser kickoff.
# Re-running kills and recreates the session.
#
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND_DIR="$REPO_ROOT/app/runtime/service"
FRONTEND_DIR="$REPO_ROOT/app/clients/web"
DEV_TOOLS_DIR="$REPO_ROOT/app/tooling/dev_tools"
SUPERVISOR_DIR="$REPO_ROOT/app/runtime/supervisor"
APP_VERSION=$(node -p "require('$REPO_ROOT/app/hosts/desktop/package.json').version")
BUILD_PERSPECTIVE="${MEADOW_BUILD_PERSPECTIVE:-standalone}"

ensure_dev_executable() {
  local dir="$1"
  local executable="$2"

  if [ -x "$dir/node_modules/.bin/$executable" ]; then
    return
  fi

  echo "Missing $executable in ${dir#$REPO_ROOT/}; installing dependencies..."
  (cd "$dir" && npm install)
}

# Packaging temporarily removes devDependencies. Repair an interrupted prune
# before starting processes that require these local executables.
ensure_dev_executable "$BACKEND_DIR" "tsx"
ensure_dev_executable "$FRONTEND_DIR" "vite"
ensure_dev_executable "$DEV_TOOLS_DIR" "vite"
ensure_dev_executable "$SUPERVISOR_DIR" "esbuild"
(cd "$SUPERVISOR_DIR" && npm run build)

# --- 1. Derive instance name from environment or directory basename ---
BASENAME="$(basename "$REPO_ROOT")"
IS_MAIN_REPO=false
if [ -n "${MEADOW_DEV_INSTANCE_NAME:-}" ]; then
  WORKTREE_NAME="$MEADOW_DEV_INSTANCE_NAME"
elif [[ "$BASENAME" =~ ^meadow_wt_(.+)$ ]]; then
  WORKTREE_NAME="${BASH_REMATCH[1]}"
elif [[ "$BASENAME" =~ ^meadow_work_(.+)$ ]]; then
  WORKTREE_NAME="${BASH_REMATCH[1]}"
elif [[ "$BASENAME" == "meadow" ]]; then
  WORKTREE_NAME="main"
  IS_MAIN_REPO=true
else
  WORKTREE_NAME="$BASENAME"
fi

if [ "${MEADOW_DEV_ISOLATED:-}" = "1" ]; then
  IS_MAIN_REPO=false
fi

SESSION="meadow_dev_${WORKTREE_NAME}"

# --- 2. Kill existing session if present ---
if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "Killing existing session '$SESSION'..."
  tmux kill-session -t "$SESSION"
fi

# --- 3. Resolve config dir & ports ---
if [ "$IS_MAIN_REPO" = true ]; then
  echo "Main repo detected: using the real Meadow home."
  CONFIG_DIR=$(cd "$BACKEND_DIR" && npx tsx src/shared/scripts/resolve_main_repo_config_dir.ts)
else
  echo "Setting up worktree resources config..."
  CONFIG_DIR=$(cd "$BACKEND_DIR" && npx tsx src/shared/scripts/setup_worktree_resources_config.ts)
fi
echo "Config directory: $CONFIG_DIR"

# --- 4. Read Dev Tools ports. Runtime ports are allocated on demand. ---
RESOURCES_YAML="$CONFIG_DIR/app/resources.yaml"
RESOURCES_LOCAL="$CONFIG_DIR/app/resources.local.yaml"

get_port() {
  local key=$1
  local default=$2
  local value=""
  if [ -f "$RESOURCES_LOCAL" ]; then
    value=$(grep "^$key:" "$RESOURCES_LOCAL" 2>/dev/null | head -1 | awk '{print $2}' || true)
  fi
  if [ -z "$value" ] && [ -f "$RESOURCES_YAML" ]; then
    value=$(grep "^$key:" "$RESOURCES_YAML" 2>/dev/null | head -1 | awk '{print $2}' || true)
  fi
  echo "${value:-$default}"
}

DEV_TOOLS_PORT=$(get_port devToolsPort 5174)
DEV_TOOLS_SERVER_PORT=$(get_port devToolsServerPort 3002)

# --- 5. Create tmux session with 3 windows ---
# Runtime and browser windows remain available for inspection commands; the
# supervisor and Dev Tools process own all actual child-process creation.
tmux new-session -d -s "$SESSION" -n runtime -c "$SUPERVISOR_DIR"
tmux set-option -w -t "$SESSION:runtime" remain-on-exit on

tmux new-window -t "$SESSION" -n browser -c "$FRONTEND_DIR"
tmux set-option -w -t "$SESSION:browser" remain-on-exit on

tmux new-window -t "$SESSION" -n dev-tools -c "$DEV_TOOLS_DIR" \
  "PORT='$DEV_TOOLS_SERVER_PORT' VITE_DEV_TOOLS_CLIENT_PORT='$DEV_TOOLS_PORT' MEADOW_HOME_DIRECTORY_OVERRIDE='$CONFIG_DIR' MEADOW_DEV_TMUX_SESSION='$SESSION' MEADOW_BUILD_PERSPECTIVE='$BUILD_PERSPECTIVE' npm start; read"

# --- 6. Wait for Dev Tools to be ready, then open browser ---
echo "Waiting for Dev Tools (http://localhost:$DEV_TOOLS_PORT)..."
for i in $(seq 1 60); do
  if curl -s -o /dev/null -w '' "http://localhost:$DEV_TOOLS_PORT" 2>/dev/null; then
    echo "Dev Tools is ready."
    if [ "${MEADOW_DEV_NO_OPEN:-}" = "1" ]; then
      echo "Skipping browser open because MEADOW_DEV_NO_OPEN=1."
    else
      open "http://localhost:$DEV_TOOLS_PORT"
    fi
    break
  fi
  if [ "$i" -eq 60 ]; then
    echo "Warning: Dev Tools did not respond within 30s. Opening anyway..."
    if [ "${MEADOW_DEV_NO_OPEN:-}" = "1" ]; then
      echo "Skipping browser open because MEADOW_DEV_NO_OPEN=1."
    else
      open "http://localhost:$DEV_TOOLS_PORT"
    fi
  fi
  sleep 0.5
done

# --- 7. Print summary ---
echo ""
echo "======================================"
echo "  Meadow dev servers running [$WORKTREE_NAME]"
echo ""
echo "  Dev Tools: http://localhost:$DEV_TOOLS_PORT"
echo "  Runtime:   starts on demand from Dev Tools App or Web mode"
echo "  Config:    $CONFIG_DIR"
echo ""
echo "  Attach: tmux attach -t $SESSION"
echo "  Kill:   tmux kill-session -t $SESSION"
echo "======================================"
