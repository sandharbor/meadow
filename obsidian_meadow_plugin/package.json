{
  "name": "obsidian-meadow-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "Open Meadow with current file information for bundle management",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "meadow"
  ],
  "author": "Meadow Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.68",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.19",
    "eslint": "^8.57.1",
    "obsidian": "latest",
    "tslib": "2.4.1",
    "typescript": "4.7.4"
  }
}
