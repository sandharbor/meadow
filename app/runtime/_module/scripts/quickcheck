#!/bin/bash
set -euo pipefail

REQUIRED_DIRS=("native" "payload" "service" "supervisor" "system_tests")
OK_DIRS=("_module")
OK_FILES=(".DS_Store")

echo_and_exit() {
    echo "$1"
    exit 1
}

for dir in "${REQUIRED_DIRS[@]}"; do
    [ -d "$dir" ] || echo_and_exit "❌ Required directory '$dir' is missing."
done

for entry in * .[^.]*; do
    [ "$entry" = "." ] && continue
    [ "$entry" = ".." ] && continue
    [ "$entry" = '.[^.]*' ] && continue
    [ ! -e "$entry" ] && continue
    allowed=false
    for candidate in "${REQUIRED_DIRS[@]}" "${OK_DIRS[@]}" "${OK_FILES[@]}"; do
        if [ "$entry" = "$candidate" ]; then
            allowed=true
            break
        fi
    done
    [ "$allowed" = true ] || echo_and_exit "❌ Extraneous entry in app/runtime/: $entry"
done

for dir in "${REQUIRED_DIRS[@]}"; do
    [ -f "$dir/_module/scripts/quickcheck" ] \
        || echo_and_exit "❌ _module/scripts/quickcheck not found at app/runtime/$dir."
done

for dir in "native" "payload"; do
    (cd "$dir" && ./_module/scripts/quickcheck)
done

# The supervisor uses isolated test Homes and does not consume service build
# outputs. Check both concurrently, then require both before system tests.
(cd supervisor && ./_module/scripts/quickcheck) &
supervisor_pid=$!
service_status=0
(cd service && ./_module/scripts/quickcheck) || service_status=$?
supervisor_status=0
wait "$supervisor_pid" || supervisor_status=$?
[ "$service_status" -eq 0 ] || echo_and_exit "❌ Runtime service checks failed."
[ "$supervisor_status" -eq 0 ] || echo_and_exit "❌ Runtime supervisor checks failed."

(cd system_tests && ./_module/scripts/quickcheck)
