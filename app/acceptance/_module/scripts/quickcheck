#!/bin/bash

# Check for required directories and files in acceptance/
REQUIRED_DIRS=(
    "agent_evals"
    "e2e"
    "report_viewer"
)
REQUIRED_FILES=(
)
OK_FILES=(".DS_Store")
OK_DIRS=("_module")

echo_and_exit() {
    echo "$1"
    exit 1
}

# The existing E2E package owns the agent-eval dependencies. Install it once
# before the ownership checks run in parallel, then expose that dependency tree
# to the sibling agent_evals sources.
e2e_stamp="e2e/node_modules/.quickcheck_install_stamp"
if [ ! -f "$e2e_stamp" ] || [ ! -d "e2e/node_modules" ] || [ "e2e/package-lock.json" -nt "$e2e_stamp" ]; then
    (cd e2e && npm install --force 2>&1 && touch "node_modules/.quickcheck_install_stamp") \
        || echo_and_exit "❌ Acceptance E2E dependency install failed."
fi
node e2e/scripts/link-agent-eval-package-views.mjs

for dir in "${REQUIRED_DIRS[@]}"; do
    if [ ! -d "$dir" ]; then
        echo_and_exit "❌ Required directory '$dir' is missing."
    fi
done

for file in "${REQUIRED_FILES[@]}"; do
    if [ ! -f "$file" ]; then
        echo_and_exit "❌ Required file '$file' is missing."
    fi
done

for entry in * .[^.]*; do
    # Skip . and .. and literal glob pattern when no matches
    [ "$entry" = "." ] && continue
    [ "$entry" = ".." ] && continue
    [ "$entry" = '.[^.]*' ] && continue
    [ ! -e "$entry" ] && continue
    is_ok=false
    for dir in "${REQUIRED_DIRS[@]}"; do
        if [ "$entry" = "$dir" ]; then
            is_ok=true
            break
        fi
    done
    for file in "${REQUIRED_FILES[@]}"; do
        if [ "$entry" = "$file" ]; then
            is_ok=true
            break
        fi
    done
    for file in "${OK_FILES[@]}"; do
        if [ "$entry" = "$file" ]; then
            is_ok=true
            break
        fi
    done
    for dir in "${OK_DIRS[@]}"; do
        if [ "$entry" = "$dir" ]; then
            is_ok=true
            break
        fi
    done
    if [ "$is_ok" = false ]; then
        echo_and_exit "❌ Extraneous file or directory found in acceptance/: $entry. Should have been moved or deleted."
    fi
done

ACCEPTANCE_LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/quickcheck-acceptance.XXXXXX")

function check_dir() {
    local dir="$1"
    local log_file="$ACCEPTANCE_LOG_DIR/${dir}.log"

    if [ ! -d "$dir" ]; then
        echo "❌ Required directory '$dir' is missing." > "$log_file"
        return 1
    fi

    if [ ! -f "$dir/_module/scripts/quickcheck" ]; then
        echo "❌ _module/scripts/quickcheck not found at $dir." > "$log_file"
        return 1
    fi

    (
        cd "$dir"
        ./_module/scripts/quickcheck
    ) > "$log_file" 2>&1
}

# Run check_dir calls in parallel for speed
echo "🧪 Running acceptance directory checks in parallel..."

ACCEPTANCE_CHECK_DIRS=("agent_evals" "e2e" "report_viewer")

pids=()
dir_for_pid=()
for dir in "${ACCEPTANCE_CHECK_DIRS[@]}"; do
    check_dir "$dir" &
    pids+=($!)
    dir_for_pid+=("$dir")
done

# Wait for all background jobs to complete
exit_code=0
failed_dirs=()
for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
        exit_code=1
        failed_dirs+=("${dir_for_pid[$i]}")
    fi
done

if [ $exit_code -ne 0 ]; then
    for dir in "${failed_dirs[@]}"; do
        log_file="$ACCEPTANCE_LOG_DIR/${dir}.log"
        echo ""
        echo "❌ acceptance/$dir failed. Log: $log_file"
        echo "--- last 30 lines ---"
        tail -30 "$log_file"
        echo "---"
    done
    echo_and_exit "❌ One or more acceptance directory checks failed (full logs in $ACCEPTANCE_LOG_DIR)"
fi

echo "✅ All acceptance checks passed!"
