#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."

stamp="node_modules/.quickcheck_install_stamp"
if [ ! -f "$stamp" ] || [ ! -d "node_modules" ] || [ "package-lock.json" -nt "$stamp" ]; then
    npm install --force 2>&1
    touch "$stamp"
fi

echo "Running acceptance E2E type checking..."
npx tsc --noEmit --project tsconfig.json
echo "Type checking passed."

echo "Testing E2E service lifecycle..."
node --import tsx --test _module/tests/*.test.ts

echo "Linting one-test-per-spec rule..."
npx tsx _module/scripts/lint-single-test-per-spec.ts

echo "Linting bundle-mode classification..."
npx tsx _module/scripts/lint-bundle-mode.ts

echo "Linting scenario app-area ownership..."
NODE_OPTIONS="${NODE_OPTIONS:-} --preserve-symlinks" npx tsx _module/scripts/lint-scenario-app-areas.ts

echo "Linting page-object boundary in specs..."
npx tsx _module/scripts/lint-no-direct-locators.ts

echo "Linting final-assertion placement in specs..."
npx tsx _module/scripts/lint-final-assertion.ts
