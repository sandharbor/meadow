{
  "name": "meadow-electron",
  "version": "0.5.45",
  "description": "Meadow Desktop Application",
  "productName": "Meadow",
  "main": "dist/hosts/desktop/src/main.js",
  "author": "Your Name",
  "license": "MIT",
  "homepage": "./",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run build:dev\" \"wait-on dist/hosts/desktop/src/main.js && electron .\"",
    "electron-dev-args": "./electron-dev.sh",
    "build": "npm run build:all && npm run build:electron",
    "build:dev": "npm run build:main -- --watch",
    "build:all": "npm run build:payload && npm run build:cli && npm run build:main",
    "build:payload": "node ../../runtime/payload/src/buildRuntimePayload.mjs --perspective ${MEADOW_BUILD_PERSPECTIVE:-standalone} --app-version $npm_package_version --output ../../runtime/payload/dist --node-executable ${MEADOW_NODE_EXECUTABLE:-../../runtime/payload/vendor/node}",
    "build:cli": "cd ../../clients/cli && npm run build",
    "build:main": "tsc",
    "build:electron": "electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist build",
    "generate-icons": "./generate-icons.sh"
  },
  "build": {
    "appId": "com.meadow.desktop",
    "productName": "Meadow",
    "protocols": [
      {
        "name": "Meadow Find in Bundles",
        "schemes": ["meadow"]
      }
    ],
    "directories": {
      "output": "build"
    },
    "afterPack": "./afterPack.js",
    "afterSign": "./afterSign.js",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../runtime/payload/dist",
        "to": "runtime-payload",
        "filter": ["**/*"]
      },
      {
        "from": "../../clients/cli/dist",
        "to": "cli",
        "filter": ["meadow.cjs"]
      },
      {
        "from": "../../clients/cli/bin/meadow",
        "to": "cli/meadow",
        "filter": ["meadow"]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "identity": "Sand Harbor Software, LLC (3Y93X67X8P)",
      "notarize": true
    },
    "dmg": {
      "title": "Install Meadow",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.4",
    "rimraf": "^5.0.10",
    "typescript": "^5.0.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.9",
    "yaml": "^2.7.1"
  }
} 
