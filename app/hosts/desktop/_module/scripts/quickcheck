#!/bin/bash

echo "🧪 Running desktop host type check..."
npx tsc --noEmit --project tsconfig.json
if [ $? -ne 0 ]; then
    echo "❌ TypeScript check failed for the desktop host."
    exit 1
fi

# Desktop embeds the complete, manifest-verified Runtime Payload. The payload
# assembler owns the lower-level service asset inventory.
echo "🧪 Checking Desktop embeds the Runtime Payload..."
node --input-type=module -e "
  import { readFileSync } from 'node:fs';
  import { GENERATION_ASSET_DIRECTORIES } from '../../runtime/payload/src/buildRuntimePayload.mjs';
  const packageJson = JSON.parse(readFileSync('./package.json', 'utf8'));
  const resources = packageJson.build.extraResources.map(entry => typeof entry === 'string' ? entry : entry.from);
  if (!resources.includes('../../runtime/payload/dist')) {
    throw new Error('Desktop extraResources must embed ../../runtime/payload/dist');
  }
  if (GENERATION_ASSET_DIRECTORIES.length === 0) {
    throw new Error('Runtime Payload generation asset inventory is empty');
  }
"

echo "✅ Desktop host checks passed"
