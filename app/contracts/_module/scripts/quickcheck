#!/bin/bash
set -euo pipefail

SHARED_TOOLING_DIR="../shared_code"

echo "🧪 Checking transport and domain contracts..."
"$SHARED_TOOLING_DIR/node_modules/.bin/tsc" --project tsconfig.json
"$SHARED_TOOLING_DIR/node_modules/.bin/eslint" --config "$SHARED_TOOLING_DIR/eslint.config.js" interfaces types places
node "$SHARED_TOOLING_DIR/check_support/check_place_definitions.js"
echo "✅ Contract checks passed!"
