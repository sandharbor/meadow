#!/bin/bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
"$REPO_ROOT/_module/scripts/require-node-version"

echo "🔧 Running prepare scripts..."

for dir in */; do
    if [ -f "$dir/_module/scripts/prepare" ]; then
        "$dir/_module/scripts/prepare"
    fi
done

echo "✅ All prepare scripts completed"
